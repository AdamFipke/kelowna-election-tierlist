---
const links = [
    { href: "/mayor/", label: "Mayor" },
    { href: "/councillor/", label: "Councillor Tier List" },
    { href: "/school-trustees/", label: "School Trustees" },
];
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<a class="skip-link" href="#main-content">
    Skip to content
</a>
<header class="fixed inset-x-0 top-0 z-50 border-b border-[var(--line)] bg-[var(--paper)] px-4 py-3 md:inset-y-0 md:right-auto md:w-64 md:border-b-0 md:border-r md:px-6 md:py-8">
    <div class="flex h-10 items-center justify-between gap-4 md:h-auto">
        <a
            class="text-base font-bold tracking-tight text-[var(--ink)] no-underline"
            href="/councillor/"
        >
            Adam's Election Notes
        </a>
        <details class="mobile-menu relative md:hidden">
            <summary
                class="menu-toggle flex size-11 cursor-pointer list-none flex-col items-center justify-center gap-1.25 rounded border border-[var(--line)] text-[var(--ink)] hover:bg-[var(--accent-soft)] focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)]"
                aria-label="Election navigation menu"
            >
                <span class="menu-bar h-0.5 w-5 rounded bg-current"></span>
                <span class="menu-bar h-0.5 w-5 rounded bg-current"></span>
                <span class="menu-bar h-0.5 w-5 rounded bg-current"></span>
            </summary>
            <nav
                class="mobile-menu-panel absolute right-0 top-[calc(100%_+_0.75rem)] z-50 w-[min(20rem,calc(100vw_-_2rem))] rounded border border-[var(--line)] bg-[var(--paper)] p-4 shadow-lg"
                aria-label="Election pages"
            >
                <h2 class="px-3 pb-2 text-sm font-bold tracking-widest text-[var(--muted)]">
                    Kelowna 2026
                </h2>
                <ul class="m-0 list-none border-l border-[var(--line)] p-0 pl-2">
                    {links.map(({ href, label }) => (
                        <li>
                            <a
                                class:list={[
                                    "flex min-h-11 items-center rounded px-3 text-[0.98rem] no-underline hover:bg-[var(--accent-soft)] hover:text-[var(--accent)]",
                                    currentPath === href.replace(/\/$/, "")
                                        ? "bg-[var(--accent-soft)] font-semibold text-[var(--accent)]"
                                        : "text-[var(--ink)]",
                                ]}
                                href={href}
                                aria-current={
                                    currentPath === href.replace(/\/$/, "")
                                        ? "page"
                                        : undefined
                                }
                                data-astro-prefetch
                            >
                                {label}
                            </a>
                        </li>
                    ))}
                </ul>
            </nav>
        </details>
    </div>
    <nav class="hidden md:block md:pt-10" aria-label="Election pages">
        <h2 class="px-3 pb-2 text-sm font-bold tracking-widest text-[var(--muted)]">
            Kelowna 2026
        </h2>
        <ul class="m-0 list-none border-l border-[var(--line)] p-0 pl-2">
            {links.map(({ href, label }) => (
                <li>
                    <a
                        class:list={[
                            "flex min-h-11 items-center rounded px-3 text-[0.98rem] no-underline hover:bg-[var(--accent-soft)] hover:text-[var(--accent)]",
                            currentPath === href.replace(/\/$/, "")
                                ? "bg-[var(--accent-soft)] font-semibold text-[var(--accent)]"
                                : "text-[var(--ink)]",
                        ]}
                        href={href}
                        aria-current={
                            currentPath === href.replace(/\/$/, "")
                                ? "page"
                                : undefined
                        }
                        data-astro-prefetch
                    >
                        {label}
                    </a>
                </li>
            ))}
        </ul>
    </nav>
</header>

<style>
    .mobile-menu summary::-webkit-details-marker {
        display: none;
    }

    .menu-bar {
        transition:
            transform 180ms ease,
            opacity 180ms ease;
    }

    .mobile-menu[open] .menu-bar:first-child {
        transform: translateY(7px) rotate(45deg);
    }

    .mobile-menu[open] .menu-bar:nth-child(2) {
        opacity: 0;
    }

    .mobile-menu[open] .menu-bar:last-child {
        transform: translateY(-7px) rotate(-45deg);
    }

    .mobile-menu-panel {
        animation: menu-enter 160ms ease-out both;
    }

    @keyframes menu-enter {
        from {
            opacity: 0;
            transform: translateY(-0.35rem);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .menu-bar,
        .mobile-menu-panel {
            animation: none;
            transition: none;
        }
    }
</style>
